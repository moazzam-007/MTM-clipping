      "parameters": {
        "jsCode": "// Prepare batch payloads and calculate spaced-out YouTube publish schedules\nconst pendingItems = $input.all().filter(r => r.json && r.json.Status === 'pending');\nif (pendingItems.length === 0) {\n  throw new Error('No pending clip rows available.');\n}\n\n// 5 Spaced Publishing Time Slots (IST):\n// Slot 0: 10:00 AM | Slot 1: 1:00 PM | Slot 2: 4:30 PM | Slot 3: 7:30 PM | Slot 4: 10:00 PM\nconst scheduleHours = [10, 13, 16.5, 19.5, 22];\nconst today = new Date();\nconst year = today.getFullYear();\nconst month = today.getMonth();\nconst day = today.getDate();\n\nconst outputItems = [];\n\nfor (let i = 0; i < pendingItems.length; i++) {\n  const row = pendingItems[i].json;\n  const startTime = parseFloat(row.Start_Sec) || 0;\n  const endTime = parseFloat(row.End_Sec) || 0;\n  const category = String(row.Category || 'shorts').toLowerCase().trim();\n\n  // Strictly enforce #Shorts logic based on category\n  let rawTitle = String(row.YT_Title || row.Roman_Urdu_Hook || 'Islamic Reminder').replace(/[<>]/g, '').trim();\n  if (category === 'shorts') {\n    if (!rawTitle.toLowerCase().includes('#shorts')) {\n      rawTitle = `${rawTitle} #Shorts`.substring(0, 100).trim();\n    }\n  } else {\n    rawTitle = rawTitle.replace(/#shorts\\b/gi, '').trim();\n  }\n\n  let desc = String(row.YT_Description || '').replace(/[<>]/g, '').trim();\n  if (!desc) {\n    desc = `${rawTitle}\\n\\nMufti Tariq Masood Bayan Short Reminder.\\nSubscribe @al__haqqq for authentic daily Islamic guidance.\\n\\n#MuftiTariqMasood #IslamicReminder #UrduBayan #AlHaqq`;\n  }\n\n  let rawTags = String(row.Tags || '#MuftiTariqMasood,#IslamicReminder,#Bayan,#AlHaqq');\n  let cleanTags = rawTags\n    .split(',')\n    .map(t => t.replace(/[<>\"#]/g, '').trim())\n    .filter(t => t.length > 0);\n  if (category === 'shorts' && !cleanTags.includes('Shorts')) {\n    cleanTags.unshift('Shorts');\n  } else if (category !== 'shorts') {\n    cleanTags = cleanTags.filter(t => t.toLowerCase() !== 'shorts');\n  }\n\n  // Calculate ISO scheduled publish time (UTC)\n  const slotHourDecimal = scheduleHours[Math.min(i, scheduleHours.length - 1)];\n  const hour = Math.floor(slotHourDecimal);\n  const minute = Math.round((slotHourDecimal - hour) * 60);\n  // Convert IST (UTC+5:30) to UTC Date\n  const pubDateIST = new Date(year, month, day, hour, minute, 0);\n  const pubDateUTC = new Date(pubDateIST.getTime() - (5.5 * 60 * 60 * 1000));\n\n  outputItems.push({\n    json: {\n      clip_id: String(row.Clip_ID || (row.Video_ID ? `${row.Video_ID}_${Math.round(startTime)}` : `clip_${Date.now()}`)),\n      url: String(row.Video_URL || '').trim(),\n      video_id: String(row.Video_ID || '').trim(),\n      start_time: startTime,\n      end_time: endTime,\n      duration: Math.round((endTime - startTime) * 10) / 10,\n      hook_text: String(row.Roman_Urdu_Hook || '').trim(),\n      arabic_sub: String(row.Arabic_Sub || '').trim(),\n      english_sub: String(row.English_Sub || '').trim(),\n      category: category,\n      yt_title: rawTitle,\n      yt_description: desc,\n      tags: cleanTags.join(','),\n      scheduled_publish_time: pubDateUTC.toISOString(),\n      _poll_count: 0\n    }\n  });\n}\n\nreturn outputItems;"
      },
