    {
      "parameters": {
        "jsCode": "// 4 Official MTM Channels to monitor for fresh & back-catalog bayanat\nreturn [\n  {\n    json: {\n      channel_name: \"Mufti Tariq Masood (Main)\",\n      channel_id: \"UCC3pnIpWMVail5J8mvYEiZA\"\n    }\n  },\n  {\n    json: {\n      channel_name: \"MTM Lectures\",\n      channel_id: \"UCYG9sAqyqjNwASrnWP96VRg\"\n    }\n  },\n  {\n    json: {\n      channel_name: \"Islam Tube Urdu\",\n      channel_id: \"UCWPNaE1AK9kwnm4Hg1pP6sg\"\n    }\n  },\n  {\n    json: {\n      channel_name: \"MTM Speeches\",\n      channel_id: \"UCggXnpOoeQbVu0lz-hms63A\"\n    }\n  }\n];"
      },
      "id": "node-define-channels",
      "name": "📋 Define MTM Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2960,
        500
      ]
    },
    {
      "parameters": {
        "url": "=https://www.youtube.com/feeds/videos.xml?channel_id={{ $json.channel_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-fetch-channel-rss",
      "name": "📡 Fetch Channel RSS Feeds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2720,
        500
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Parse YouTube Atom Feed for each channel and collect candidate videos (up to 15 per channel = 60 total)\nconst allCandidates = [];\n\nfor (const item of $input.all()) {\n  const xmlText = String(item.json.data || item.json.body || '');\n  if (!xmlText || !xmlText.includes('<entry>')) {\n    continue;\n  }\n\n  const entries = xmlText.match(/<entry>[\\s\\S]*?<\\/entry>/g) || [];\n  for (const entry of entries) {\n    const idMatch = entry.match(/<yt:videoId>(.*?)<\\/yt:videoId>/);\n    const titleMatch = entry.match(/<title>(.*?)<\\/title>/);\n    const linkMatch = entry.match(/<link rel=\"alternate\" href=\"(.*?)\"\\/>/);\n    const publishedMatch = entry.match(/<published>(.*?)<\\/published>/);\n\n    const videoId = idMatch ? idMatch[1].trim() : '';\n    if (!videoId) continue;\n\n    let title = titleMatch ? titleMatch[1].trim() : 'Mufti Tariq Masood Bayan';\n    // Skip explicit YouTube Shorts in feed\n    if (/#shorts\\b/i.test(title)) {\n      continue;\n    }\n\n    // Clean XML entities in title\n    title = title\n      .replace(/&amp;/g, '&')\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/&quot;/g, '\"')\n      .replace(/&#39;/g, \"'\");\n\n    const url = linkMatch ? linkMatch[1].trim() : `https://youtu.be/${videoId}`;\n    const published = publishedMatch ? publishedMatch[1].trim() : new Date().toISOString();\n\n    allCandidates.push({\n      json: {\n        video_id: videoId,\n        title: title,\n        url: url,\n        published: published\n      }\n    });\n  }\n}\n\nif (allCandidates.length === 0) {\n  throw new Error(\"No video entries extracted from any of the MTM YouTube channels!\");\n}\n\nreturn allCandidates;"
      },
      "id": "node-parse-all-rss",
      "name": "📝 Parse All Candidate Videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2480,
        500
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID || 'YOUR_GOOGLE_SHEET_ID_HERE' }}",
          "mode": "id"
        },
