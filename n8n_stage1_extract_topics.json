      "parameters": {
        "jsCode": "// Filter pending videos and select 1 video to process\nconst allRows = $input.all().map(i => i.json || {});\nconst pendingItems = allRows.filter(r => String(r.Status || '').toLowerCase().trim() === 'pending');\n\nif (pendingItems.length === 0) {\n  return [{\n    json: {\n      has_pending: false,\n      total_pending: 0\n    }\n  }];\n}\n\nconst selected = pendingItems[0];\nreturn [{\n  json: {\n    ...selected,\n    has_pending: true,\n    total_pending: pendingItems.length,\n    video_id: String(selected.Video_ID || selected.video_id || '').trim(),\n    video_url: String(selected.Video_URL || selected.video_url || '').trim()\n  }\n}];"
      },
