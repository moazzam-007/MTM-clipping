    {
      "parameters": {
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UC7hM1hU3m6E78H-UuGgR6ug",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-fetch-yt-rss",
      "name": "📡 Fetch MTM Latest RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2760,
        600
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Parse YouTube Atom Feed and decode XML entities\nconst xmlText = String($input.first().json.data || $input.first().json.body || '');\n\nif (!xmlText || !xmlText.includes('<entry>')) {\n  throw new Error(\"YouTube RSS Feed did not return any <entry> video elements!\");\n}\n\nconst entryMatch = xmlText.match(/<entry>[\\s\\S]*?<\\/entry>/);\nif (!entryMatch) {\n  throw new Error(\"Failed to extract latest video entry from YouTube RSS!\");\n}\n\nconst entry = entryMatch[0];\nconst idMatch = entry.match(/<yt:videoId>(.*?)<\\/yt:videoId>/);\nconst titleMatch = entry.match(/<title>(.*?)<\\/title>/);\nconst linkMatch = entry.match(/<link rel=\"alternate\" href=\"(.*?)\"\\/>/);\nconst publishedMatch = entry.match(/<published>(.*?)<\\/published>/);\n\nconst videoId = idMatch ? idMatch[1].trim() : '';\nif (!videoId) {\n  throw new Error(\"Extracted Video ID is empty!\");\n}\n\n// Clean XML entities in title\nlet title = titleMatch ? titleMatch[1].trim() : 'Mufti Tariq Masood Bayan';\ntitle = title\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\");\n\nconst url = linkMatch ? linkMatch[1].trim() : `https://youtu.be/${videoId}`;\nconst published = publishedMatch ? publishedMatch[1].trim() : new Date().toISOString();\n\nreturn [{\n  json: {\n    video_id: videoId,\n    title: title,\n    url: url,\n    published: published\n  }\n}];"
      },
      "id": "node-parse-rss",
      "name": "📝 Parse Latest Video Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2520,
        600
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Clips_Queue",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
