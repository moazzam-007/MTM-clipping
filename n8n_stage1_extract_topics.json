    {
      "parameters": {
        "jsCode": "// Parse Telegram message, enforce admin security, and validate YouTube URL\nconst item = $input.first().json;\nconst message = item.message || item.edited_message || {};\nconst text = String(message.text || '').trim();\nconst chatId = String((message.chat && message.chat.id) || (message.from && message.from.id) || '');\n\n// Security: Only Moazzam (Admin Chat ID: 1306188611) can interact with this bot\nconst ADMIN_CHAT_ID = \"1306188611\";\nif (chatId !== ADMIN_CHAT_ID) {\n  return [{\n    json: {\n      action: \"unauthorized\",\n      user_chat_id: chatId,\n      reply_text: \"⛔ <b>Access Denied:</b> Aap is automation bot ko use karne ke liye authorized nahi hain.\"\n    }\n  }];\n}\n\n// Check for YouTube URL (supports /q <url> or direct link)\nconst urlMatch = text.match(/https?:\\/\\/(?:www\\.)?(?:youtube\\.com\\/(?:watch\\?v=|embed\\/|shorts\\/)|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/i);\n\nif (!urlMatch) {\n  return [{\n    json: {\n      action: \"invalid_format\",\n      user_chat_id: chatId,\n      reply_text: \"⚠️ <b>Format Sahi Nahi Hai!</b>\\n\\nYouTube Bayan add karne ke liye is tarah link bhejiye:\\n👉 <code>/q https://youtu.be/VIDEO_ID</code>\\n<i>(Ya direct YouTube link paste karein).</i>\"\n    }\n  }];\n}\n\nconst videoId = urlMatch[1];\nconst canonicalUrl = `https://youtu.be/${videoId}`;\n\nreturn [{\n  json: {\n    action: \"queue\",\n    video_id: videoId,\n    video_url: canonicalUrl,\n    user_chat_id: chatId,\n    raw_text: text,\n    date_added: new Date().toISOString()\n  }\n}];"
      },
