    {
      "parameters": {
        "jsCode": "// Validate extracted clip boundaries and metadata\nconst validItems = [];\n\nfor (const item of $input.all()) {\n  const t = item.json || {};\n  const start = Number(t.start_time);\n  const end = Number(t.end_time);\n  const hook = String(t.roman_urdu_hook || '').trim();\n  const title = String(t.yt_title || '').trim();\n  \n  // Check finite numbers, start < end, duration between 35s and 360s\n  if (Number.isFinite(start) && Number.isFinite(end) && end > start) {\n    const dur = end - start;\n    if (dur >= 35 && dur <= 360 && hook.length > 5 && title.length > 5) {\n      validItems.push({\n        json: {\n          ...t,\n          video_id: t.video_id || '',\n          video_url: t.video_url || '',\n          lecture_title: t.lecture_title || '',\n          start_time: start,\n          end_time: end,\n          duration_sec: parseFloat(dur.toFixed(1)),\n          roman_urdu_hook: hook,\n          yt_title: title\n        }\n      });\n    }\n  }\n}\n\nif (validItems.length === 0) {\n  throw new Error(\"No valid topics passed validation criteria!\");\n}\n\nreturn validItems;"
      },
      "id": "9eb2219e-0d91-4873-901a-31ea9bab1d7f",
      "name": "🛡️ Validate Clip Boundaries & Metadata",
      "type": "n8n-nodes-base.code",
