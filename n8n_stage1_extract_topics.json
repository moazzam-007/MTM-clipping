      "parameters": {
        "jsCode": "// Parse Telegram message for /q command and extract clean YouTube URL\nconst item = $input.first().json;\nconst message = item.message || item.edited_message || {};\nconst text = String(message.text || '').trim();\nconst chatId = String((message.chat && message.chat.id) || '1306188611');\n\nconst urlMatch = text.match(/https?:\\/\\/(?:www\\.)?(?:youtube\\.com\\/(?:watch\\?v=|embed\\/|shorts\\/)|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/i);\n\nif (!urlMatch) {\n  throw new Error(\"Format galat hai! Kripya is tarah send karein: /q https://youtu.be/VIDEO_ID\");\n}\n\nconst videoId = urlMatch[1];\nconst canonicalUrl = `https://youtu.be/${videoId}`;\n\nreturn [{\n  json: {\n    video_id: videoId,\n    video_url: canonicalUrl,\n    user_chat_id: chatId,\n    raw_text: text,\n    date_added: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-tg-parse-url",
      "name": "🔍 Parse /q YouTube URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
