            "Arabic_Sub": "={{ $json.arabic_sub || '' }}",
            "English_Sub": "={{ $json.english_sub || '' }}",
            "YT_Title": "={{ $json.yt_title }}",
            "YT_Description": "={{ $json.yt_description }}",
            "Tags": "={{ Array.isArray($json.tags) ? $json.tags.join(',') : ($json.tags || '') }}",
            "Status": "pending"
          }
        },
        "options": {}
