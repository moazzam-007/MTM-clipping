          "__rl": true,
          "value": "Clips_Queue",
          "mode": "name"
        },
        "options": {}
      },
      "id": "node-read-existing-sheet-ids",
      "name": "📊 Read Existing Sheet Video IDs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -2240,
        500
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Cross-reference candidate videos against Google Sheet to pick fresh / back-catalog videos (up to 4-5 videos total)\nconst existingRows = $input.all().map(i => i.json || {});\nconst processedVideoIds = new Set();\n\nfor (const r of existingRows) {\n  const vid = String(r.Video_ID || r.video_id || '').trim();\n  if (vid) {\n    processedVideoIds.add(vid);\n  }\n}\n\n// Retrieve candidates from the parser node\nconst candidateItems = $('📝 Parse All Candidate Videos').all().map(i => i.json || {});\nconst selectedVideos = [];\nconst selectedIds = new Set();\n\nfor (const c of candidateItems) {\n  if (!c.video_id) continue;\n  // If already processed in Google Sheet, skip\n  if (processedVideoIds.has(c.video_id)) continue;\n  // If already selected in this batch, skip\n  if (selectedIds.has(c.video_id)) continue;\n\n  selectedVideos.push({\n    json: c\n  });\n  selectedIds.add(c.video_id);\n\n  // Limit to 4-5 videos per daily execution\n  if (selectedVideos.length >= 5) {\n    break;\n  }\n}\n\nreturn selectedVideos;"
      },
      "id": "node-select-unprocessed-videos",
      "name": "🎯 Select 5 Fresh/Old Videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2000,
        500
      ]
    },
